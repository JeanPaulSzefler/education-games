extends RefCounted

# Dodatki i gry edukacyjne (AddonData): nazwy, opisy, pomoce, napisy z trybow
# walki (AddonModes, klucze "am_") i zadania bingo.
# Kolejnosc jezykow: pl, en, es, fr, de, pt, uk (Lang.CODES).
const STRINGS := {
	"addon_memory": ["Pamięć ogrodnika", "Gardener's Memory", "Memoria del Jardinero", "Mémoire du Jardinier", "Gärtner-Memo", "Memória do Jardineiro", "Пам'ять садівника"],
	"addon_memory_desc": ["Odkrywaj pary kart z roślinkami. Każda próba kosztuje 1 ruch z Roślinnych trójek, a znaleziona para go oddaje i daje roślince punkt do ulepszenia.", "Find pairs of plant cards. Each try costs 1 Plant Trios move; a pair gives it back and an upgrade point to the plant.", "Encuentra parejas de cartas. Cada intento cuesta 1 movimiento de Tríos; una pareja lo devuelve y da un punto de mejora a la planta.", "Trouve des paires de cartes. Chaque essai coûte 1 coup des Trios ; une paire le rend et donne un point d'amélioration.", "Finde Kartenpaare. Jeder Versuch kostet 1 Dreier-Zug; ein Paar gibt ihn zurück und der Pflanze einen Upgrade-Punkt.", "Encontre pares de cartas. Cada tentativa custa 1 jogada dos Trios; um par a devolve e dá um ponto de melhoria à planta.", "Шукай пари карток із рослинками. Кожна спроба коштує 1 хід Рослинних трійок, а пара його повертає й дає рослинці очко покращення."],
	"addon_memory_help": ["Podgląd całej planszy przez 3 s", "See the whole board for 3 s", "Ver todo el tablero 3 s", "Voir tout le plateau 3 s", "Ganzes Feld 3 s sehen", "Ver o tabuleiro todo por 3 s", "Побачити все поле на 3 с"],
	"addon_seasons": ["Pory roku", "Seasons", "Estaciones", "Saisons", "Jahreszeiten", "Estações", "Пори року"],
	"addon_seasons_desc": ["Każdy etap to inna pora roku. Wiosną Kaktusy dają więcej kropel, latem upał osłabia rośliny bez Liścia Bananowca obok, jesienią wiatr odpycha śmieci, a zimą wszystko zwalnia.", "Each stage is a different season. In spring Cacti give more drops, in summer heat hurts plants without a Banana Leaf nearby, in autumn wind pushes the trash back, in winter everything slows down.", "Cada etapa es una estación. En primavera los Cactus dan más gotas, en verano el calor daña plantas sin Hoja de Plátano cerca, en otoño el viento empuja la basura y en invierno todo va más lento.", "Chaque étape est une saison. Au printemps les Cactus donnent plus de gouttes, l'été la chaleur abîme les plantes sans Feuille de Bananier, l'automne le vent repousse les déchets, l'hiver tout ralentit.", "Jede Etappe ist eine Jahreszeit. Im Frühling geben Kakteen mehr Tropfen, im Sommer schadet Hitze Pflanzen ohne Bananenblatt daneben, im Herbst schiebt Wind den Müll zurück, im Winter wird alles langsamer.", "Cada etapa é uma estação. Na primavera os Cactos dão mais gotas, no verão o calor fere plantas sem Folha de Bananeira perto, no outono o vento empurra o lixo, no inverno tudo fica lento.", "Кожен етап - інша пора року. Навесні Кактуси дають більше крапель, улітку спека шкодить рослинкам без Бананового Листа поруч, восени вітер відкидає сміття, а взимку все сповільнюється."],
	"addon_seasons_help": ["Parasol wyłącza porę roku na 30 s", "An umbrella stops the season for 30 s", "Un paraguas detiene la estación 30 s", "Un parapluie arrête la saison 30 s", "Ein Schirm stoppt die Jahreszeit 30 s", "Um guarda-chuva para a estação por 30 s", "Парасоля вимикає пору року на 30 с"],
	"addon_catch": ["Łapanie kropli", "Drop Catcher", "Atrapa Gotas", "Attrape-Gouttes", "Tropfenfänger", "Pega-Gotas", "Лови краплі"],
	"addon_catch_desc": ["Łap konewką spadające krople i nawozy, a omijaj śmieci. Nawóz podwaja punkty, śmieć zabiera serce. Za wynik dostajesz sadzonki.", "Catch falling drops and fertilizer with the watering can and avoid trash. Fertilizer doubles points, trash takes a heart. Your score earns saplings.", "Atrapa con la regadera gotas y abono y esquiva la basura. El abono duplica los puntos y la basura quita un corazón. Tu puntuación da brotes.", "Attrape gouttes et engrais avec l'arrosoir et évite les déchets. L'engrais double les points, un déchet coûte un cœur. Ton score donne des pousses.", "Fang mit der Gießkanne Tropfen und Dünger und weiche Müll aus. Dünger verdoppelt Punkte, Müll kostet ein Herz. Dein Ergebnis bringt Setzlinge.", "Pegue gotas e adubo com o regador e desvie do lixo. Adubo dobra os pontos, lixo tira um coração. Sua pontuação dá mudas.", "Лови лійкою краплі й добрива, а сміття оминай. Добриво подвоює очки, сміття забирає серце. За результат отримуєш саджанці."],
	"addon_conveyor": ["Ruchome pasy ziemi", "Moving Belts", "Cintas Móviles", "Tapis Roulants", "Laufbänder", "Esteiras Móveis", "Рухомі Стрічки"],
	"addon_conveyor_desc": ["Rzędy 2 i 4 to ruchome taśmy: co 15 s rośliny na nich przesuwają się o pole w lewo. Zepchnięta z planszy wraca na pasek i musi się odnowić.", "Rows 2 and 4 are moving belts: every 15 s their plants move one spot left. A plant pushed off the board goes back to the bar and must recharge.", "Las filas 2 y 4 son cintas: cada 15 s sus plantas avanzan una casilla a la izquierda. La que cae del tablero vuelve a la barra y debe recargarse.", "Les rangées 2 et 4 sont des tapis : toutes les 15 s leurs plantes avancent d'une case à gauche. Celle qui tombe revient sur la barre et doit se recharger.", "Reihen 2 und 4 sind Laufbänder: alle 15 s rücken ihre Pflanzen ein Feld nach links. Fällt eine herunter, kommt sie zurück in die Leiste und muss nachwachsen.", "As fileiras 2 e 4 são esteiras: a cada 15 s as plantas andam um lugar para a esquerda. A que cai volta à barra e precisa recarregar.", "Ряди 2 і 4 - рухомі стрічки: кожні 15 с рослинки на них зсуваються на поле ліворуч. Зіштовхнута з поля повертається на панель і має відновитися."],
	"addon_conveyor_help": ["Zatrzymanie taśm na 20 s", "Stop the belts for 20 s", "Parar las cintas 20 s", "Arrêter les tapis 20 s", "Bänder 20 s anhalten", "Parar as esteiras por 20 s", "Зупинити стрічки на 20 с"],
	"addon_bingo": ["Ogrodowe bingo", "Garden Bingo", "Bingo del Jardín", "Bingo du Jardin", "Garten-Bingo", "Bingo do Jardim", "Садове Бінго"],
	"addon_bingo_desc": ["Karta 16 zadań do wykonania w zwykłych grach przez 5 dni. Każda pełna linia to nagroda, a cała karta - rubiny.", "A card of 16 tasks to do in normal games over 5 days. Each full line is a reward, the whole card gives rubies.", "Una tarjeta de 16 tareas para cumplir en partidas normales durante 5 días. Cada línea completa da premio y la tarjeta entera, rubíes.", "Une carte de 16 tâches à faire dans tes parties pendant 5 jours. Chaque ligne complète donne un cadeau, la carte entière des rubis.", "Eine Karte mit 16 Aufgaben für normale Spiele in 5 Tagen. Jede volle Reihe bringt eine Belohnung, die ganze Karte Rubine.", "Uma cartela de 16 tarefas para cumprir em jogos normais por 5 dias. Cada linha completa dá prêmio e a cartela toda, rubis.", "Картка з 16 завдань для звичайних ігор на 5 днів. Кожна повна лінія - нагорода, уся картка - рубіни."],
	"addon_bingo_help": ["Zamiana jednego zadania na inne", "Swap one task for another", "Cambiar una tarea por otra", "Échanger une tâche", "Eine Aufgabe tauschen", "Trocar uma tarefa por outra", "Замінити одне завдання"],
	"addon_storm": ["Burza", "Storm", "Tormenta", "Orage", "Gewitter", "Tempestade", "Гроза"],
	"addon_storm_desc": ["Co jakiś czas nadciąga burza: deszcz przyspiesza śmieci w dwóch rzędach, a piorun niszczy kupkę śmieci albo roślinę.", "Now and then a storm comes: rain speeds up the trash in two rows and lightning destroys a trash pile or a plant.", "De vez en cuando llega una tormenta: la lluvia acelera la basura en dos filas y un rayo destruye un montón o una planta.", "De temps en temps un orage arrive : la pluie accélère les déchets sur deux rangées et la foudre détruit un tas ou une plante.", "Ab und zu kommt ein Gewitter: Regen macht den Müll in zwei Reihen schneller, ein Blitz zerstört einen Haufen oder eine Pflanze.", "De vez em quando vem uma tempestade: a chuva acelera o lixo em duas fileiras e um raio destrói um monte ou uma planta.", "Час від часу налітає гроза: дощ пришвидшує сміття у двох рядах, а блискавка знищує купку або рослинку."],
	"addon_storm_help": ["Piorunochron chroni pola 3x3", "A lightning rod protects a 3x3 area", "Un pararrayos protege un área de 3x3", "Un paratonnerre protège une zone 3x3", "Ein Blitzableiter schützt 3x3 Felder", "Um para-raios protege uma área 3x3", "Громовідвід захищає поля 3x3"],
	"addon_maze": ["Labirynt pszczółki", "Bee Maze", "Laberinto de la Abejita", "Labyrinthe de l'Abeille", "Bienen-Labyrinth", "Labirinto da Abelhinha", "Лабіринт бджілки"],
	"addon_maze_desc": ["Prowadź pszczółkę przez labirynt do kwiatka. Nektar skraca czas, pajęczyna cofa na start. Szybciej = więcej gwiazdek.", "Guide the bee through the maze to the flower. Nectar cuts your time, a web sends you back. Faster = more stars.", "Guía a la abejita por el laberinto hasta la flor. El néctar resta tiempo y la telaraña te devuelve al inicio. Más rápido = más estrellas.", "Guide l'abeille dans le labyrinthe jusqu'à la fleur. Le nectar fait gagner du temps, une toile renvoie au départ. Plus vite = plus d'étoiles.", "Führe das Bienchen durch das Labyrinth zur Blume. Nektar spart Zeit, ein Netz schickt dich zurück. Schneller = mehr Sterne.", "Leve a abelhinha pelo labirinto até a flor. Néctar reduz o tempo, teia volta ao início. Mais rápido = mais estrelas.", "Веди бджілку лабіринтом до квітки. Нектар скорочує час, павутина повертає на старт. Швидше = більше зірок."],
	"addon_river": ["Rzeka przez ogród", "River Garden", "Río en el Jardín", "Rivière au Jardin", "Fluss im Garten", "Rio no Jardim", "Річка через сад"],
	"addon_river_desc": ["Środkowym rzędem płynie rzeka: śmieci płyną nią dwa razy szybciej, a sadzić można tylko na kładkach. Kaktusy przy rzece dają krople szybciej.", "A river runs through the middle row: trash floats twice as fast and you can only plant on bridges. Cacti by the river make drops faster.", "Un río cruza la fila central: la basura va el doble de rápido y solo se planta en puentes. Los Cactus junto al río dan gotas más rápido.", "Une rivière traverse la rangée du milieu : les déchets y vont deux fois plus vite et on ne plante que sur des passerelles. Les Cactus au bord donnent plus vite.", "Durch die mittlere Reihe fließt ein Fluss: Müll treibt doppelt so schnell, gepflanzt wird nur auf Stegen. Kakteen am Fluss geben schneller Tropfen.", "Um rio corre na fileira do meio: o lixo vai duas vezes mais rápido e só se planta em pontes. Cactos perto do rio dão gotas mais rápido.", "Середнім рядом тече річка: сміття пливе удвічі швидше, а садити можна лише на кладках. Кактуси біля річки дають краплі швидше."],
	"addon_river_help": ["2 darmowe kładki", "2 free bridges", "2 puentes gratis", "2 passerelles gratuites", "2 Gratis-Stege", "2 pontes grátis", "2 безкоштовні кладки"],
	"addon_album": ["Album naklejek", "Sticker Album", "Álbum de Pegatinas", "Album d'Autocollants", "Stickeralbum", "Álbum de Adesivos", "Альбом наліпок"],
	"addon_album_desc": ["Za wygrane i zbiory w ogrodzie dostajesz naklejki z roślinkami i śmieciostworami. Pełna strona albumu to rubiny, a powtórki wymienisz ze znajomym.", "Wins and garden harvests give you stickers of plants and trash monsters. A full album page gives rubies, and you can swap duplicates with a friend.", "Las victorias y cosechas te dan pegatinas de plantas y monstruos. Una página llena da rubíes y puedes cambiar las repetidas con un amigo.", "Victoires et récoltes te donnent des autocollants de plantes et de monstres. Une page pleine donne des rubis, et tu peux échanger les doubles avec un ami.", "Siege und Ernten bringen Sticker von Pflanzen und Müllmonstern. Eine volle Seite gibt Rubine, Doppelte tauschst du mit einem Freund.", "Vitórias e colheitas dão adesivos de plantas e monstros. Uma página cheia dá rubis, e você troca os repetidos com um amigo.", "За перемоги й урожаї отримуєш наліпки з рослинками і сміттєвими монстрами. Повна сторінка - рубіни, а дублікати можна обміняти з другом."],
	"addon_tree": ["Ochrona drzewka", "Guard the Tree", "Protege el Árbol", "Protège l'Arbre", "Schütze den Baum", "Proteja a Árvore", "Захисти деревце"],
	"addon_tree_desc": ["Na planszy rośnie Drzewko Życia. Śmieci idą do niego zamiast do domu - nie daj go zjeść! Po każdej fali Drzewko daje krople.", "The Tree of Life grows on the board. The trash goes for it instead of the house - don't let it be eaten! After each wave the Tree gives drops.", "En el tablero crece el Árbol de la Vida. La basura va hacia él en vez de a la casa: ¡que no se lo coman! Tras cada oleada da gotas.", "L'Arbre de Vie pousse sur le plateau. Les déchets vont vers lui au lieu de la maison : ne le laisse pas se faire manger ! Après chaque vague, il donne des gouttes.", "Auf dem Feld wächst der Lebensbaum. Der Müll will zu ihm statt zum Haus - lass ihn nicht auffressen! Nach jeder Welle gibt der Baum Tropfen.", "A Árvore da Vida cresce no tabuleiro. O lixo vai até ela em vez da casa: não deixe que a comam! Após cada onda ela dá gotas.", "На полі росте Деревце Життя. Сміття йде до нього замість дому - не дай його з'їсти! Після кожної хвилі Деревце дає краплі."],
	"addon_tree_help": ["Drzewko z podwójnym życiem", "The Tree starts with double health", "El Árbol empieza con doble vida", "L'Arbre commence avec double vie", "Der Baum startet mit doppeltem Leben", "A Árvore começa com vida dobrada", "Деревце з подвійним життям"],
	"addon_path_build": ["Budowanie ścieżki", "Path Builder", "Constructor de Caminos", "Bâtisseur de Chemin", "Wegbauer", "Construtor de Caminho", "Будівник стежки"],
	"addon_path_build_desc": ["Ułóż z kamieni krętą ścieżkę, którą przejdą śmieci, a potem posadź obok niej roślinki strzelające we wszystkie strony.", "Lay a twisty stone path for the trash to walk, then plant shooters next to it that fire in all directions.", "Coloca piedras para hacer un camino con curvas por el que irá la basura y planta a su lado plantas que disparan en todas direcciones.", "Pose des pierres pour faire un chemin sinueux que suivront les déchets, puis plante à côté des plantes qui tirent dans toutes les directions.", "Lege mit Steinen einen kurvigen Weg für den Müll und pflanze daneben Pflanzen, die in alle Richtungen schießen.", "Monte com pedras um caminho sinuoso para o lixo e plante ao lado plantas que atiram para todos os lados.", "Виклади з каменів звивисту стежку для сміття, а потім посади поруч рослинки, що стріляють у всі боки."],
	"addon_path_build_help": ["3 dodatkowe kamienie", "3 extra stones", "3 piedras extra", "3 pierres en plus", "3 extra Steine", "3 pedras extras", "3 додаткові камені"],
	"addon_treasures": ["Skarby w ziemi", "Buried Treasure", "Tesoros Enterrados", "Trésors Enfouis", "Schätze im Boden", "Tesouros Enterrados", "Скарби в землі"],
	"addon_treasures_desc": ["Pod 6 polami ukryte są skarby: krople, nawóz, roślimonety, a czasem rubin. Posadź na nich roślinkę, zanim śmieci je ukradną.", "6 spots hide treasures: drops, fertilizer, plant coins and sometimes a ruby. Plant on them before the trash steals them.", "6 casillas esconden tesoros: gotas, abono, plantamonedas y a veces un rubí. Planta encima antes de que la basura los robe.", "6 cases cachent des trésors : gouttes, engrais, pièces-plantes et parfois un rubis. Plante dessus avant que les déchets les volent.", "Unter 6 Feldern liegen Schätze: Tropfen, Dünger, Pflanzenmünzen und manchmal ein Rubin. Pflanze darauf, bevor der Müll sie klaut.", "6 lugares escondem tesouros: gotas, adubo, moedas-planta e às vezes um rubi. Plante neles antes que o lixo os roube.", "Під 6 полями заховані скарби: краплі, добриво, рослимонети, а часом рубін. Посади на них рослинку, поки сміття їх не вкрало."],
	"addon_treasures_help": ["Wykrywacz pokazuje 2 skarby", "A detector shows 2 treasures", "Un detector muestra 2 tesoros", "Un détecteur montre 2 trésors", "Ein Detektor zeigt 2 Schätze", "Um detector mostra 2 tesouros", "Детектор показує 2 скарби"],
	"addon_swarm": ["Pszczeli rój", "Bee Swarm", "Enjambre", "Essaim", "Bienenschwarm", "Enxame", "Бджолиний рій"],
	"addon_swarm_desc": ["Co chwilę przelatuje pszczółka. Złap ją i wybierz premię na 15 s: szybsze odnawianie, wolniejsze śmieci albo więcej kropel.", "A bee flies by every so often. Catch it and pick a 15 s bonus: faster recharge, slower trash or more drops.", "De vez en cuando pasa una abejita. Atrápala y elige un premio de 15 s: recarga rápida, basura lenta o más gotas.", "Une abeille passe de temps en temps. Attrape-la et choisis un bonus de 15 s : recharge rapide, déchets lents ou plus de gouttes.", "Ab und zu fliegt ein Bienchen vorbei. Fang es und wähle einen 15-s-Bonus: schneller nachwachsen, langsamerer Müll oder mehr Tropfen.", "De vez em quando passa uma abelhinha. Pegue-a e escolha um bônus de 15 s: recarga rápida, lixo lento ou mais gotas.", "Час від часу пролітає бджілка. Злови її й обери бонус на 15 с: швидше відновлення, повільніше сміття або більше крапель."],
	"addon_swarm_help": ["Pierwsza pszczółka od razu i na dłużej", "The first bee comes at once and stays longer", "La primera abejita llega enseguida y se queda más", "La première abeille arrive tout de suite et reste plus longtemps", "Das erste Bienchen kommt sofort und bleibt länger", "A primeira abelhinha vem na hora e fica mais", "Перша бджілка прилітає одразу й довше"],
	"addon_puzzle": ["Zagadka obronna", "Defence Puzzle", "Rompecabezas Defensivo", "Énigme de Défense", "Verteidigungsrätsel", "Quebra-cabeça de Defesa", "Оборонна загадка"],
	"addon_puzzle_desc": ["Gotowa plansza i stała liczba kropel. Dosadź kilka roślin i naciśnij Start - potem fala idzie sama i nic już nie zmienisz.", "A ready board and a fixed number of drops. Add a few plants and press Start - then the wave comes and you can't change anything.", "Un tablero preparado y gotas fijas. Añade unas plantas y pulsa Empezar: luego llega la oleada y ya no puedes cambiar nada.", "Un plateau prêt et un nombre fixe de gouttes. Ajoute quelques plantes et appuie sur Go : ensuite la vague arrive et tu ne peux plus rien changer.", "Ein fertiges Feld und feste Tropfen. Pflanze ein paar Pflanzen dazu und drück Los - dann kommt die Welle und du kannst nichts mehr ändern.", "Um tabuleiro pronto e gotas fixas. Plante algumas plantas e toque Começar: aí a onda vem e você não muda mais nada.", "Готове поле і задана кількість крапель. Досади кілька рослинок і натисни Старт - далі хвиля йде сама, і змінити нічого не можна."],
	"addon_puzzle_help": ["Podpowiedź jednego pola", "A hint for one spot", "Una pista de una casilla", "Un indice pour une case", "Ein Tipp für ein Feld", "Uma dica de um lugar", "Підказка одного поля"],
	"addon_duel": ["Pojedynek ze znajomym", "Duel a Friend", "Duelo con un Amigo", "Duel entre Amis", "Duell mit Freund", "Duelo com um Amigo", "Поєдинок із другом"],
	"addon_duel_desc": ["Tydzień pojedynków: każdy broni swojego ogrodu, a każdy pokonany wróg leci do znajomego. Wygrane dają w tym czasie dodatkowe nagrody.", "Duel week: you each defend your own garden and every enemy you defeat goes to your friend. Wins give extra rewards this week.", "Semana de duelos: cada uno defiende su jardín y cada enemigo derrotado va a tu amigo. Las victorias dan premios extra.", "Semaine des duels : chacun défend son jardin et chaque ennemi vaincu part chez ton ami. Les victoires donnent des bonus.", "Duell-Woche: jeder verteidigt seinen Garten, jeder besiegte Gegner geht zum Freund. Siege bringen extra Belohnungen.", "Semana dos duelos: cada um defende seu jardim e cada inimigo derrotado vai para o amigo. Vitórias dão prêmios extras.", "Тиждень поєдинків: кожен захищає свій сад, а переможений ворог летить до друга. Перемоги дають додаткові нагороди."],
	"addon_single_plant": ["Jedna roślinka", "One Plant", "Una Sola Planta", "Une Seule Plante", "Nur eine Pflanze", "Uma Só Planta", "Одна рослинка"],
	"addon_single_plant_desc": ["Grasz tylko Kaktusem i jedną wylosowaną roślinką - na każdym etapie inną. Jednorazowe odnawiają się szybciej, a strzelające dostają nawóz na start.", "You play only with a Cactus and one random plant - a different one each stage. One-time plants recharge faster, shooters get a fertilizer to start.", "Juegas solo con un Cactus y una planta al azar, distinta en cada etapa. Las de un uso se recargan antes y las que disparan reciben abono.", "Tu joues seulement avec un Cactus et une plante au hasard, différente à chaque étape. Les plantes à usage unique se rechargent plus vite, les tireuses ont un engrais.", "Du spielst nur mit Kaktus und einer zufälligen Pflanze - jede Etappe eine andere. Einmalige wachsen schneller nach, Schützen bekommen Dünger.", "Você joga só com um Cacto e uma planta sorteada, diferente a cada etapa. As de uso único recarregam mais rápido; as que atiram ganham adubo.", "Граєш лише Кактусом і однією випадковою рослинкою - щоразу іншою. Одноразові відновлюються швидше, а стрільці мають добриво на старті."],
	"addon_single_plant_help": ["Wylosuj inną roślinkę (raz)", "Draw a different plant (once)", "Sacar otra planta (una vez)", "Tirer une autre plante (une fois)", "Andere Pflanze ziehen (einmal)", "Sortear outra planta (uma vez)", "Витягнути іншу рослинку (раз)"],
	"addon_seeds": ["Zbieracz nasion", "Seed Collector", "Recolector de Semillas", "Collecteur de Graines", "Samensammler", "Coletor de Sementes", "Збирач насіння"],
	"addon_seeds_desc": ["Pokonane śmieci czasem gubią nasionko - tapnij je. Każde 5 nasion to darmowa roślinka, bez kosztu i odnawiania.", "Defeated trash sometimes drops a seed - tap it. Every 5 seeds give you a free plant, with no cost or recharge.", "La basura derrotada a veces suelta una semilla: tócala. Cada 5 semillas, una planta gratis, sin coste ni recarga.", "Les déchets vaincus lâchent parfois une graine : touche-la. Toutes les 5 graines, une plante gratuite, sans coût ni recharge.", "Besiegter Müll lässt manchmal einen Samen fallen - tippe ihn an. Alle 5 Samen gibt es eine Gratis-Pflanze ohne Kosten und Wartezeit.", "O lixo derrotado às vezes solta uma semente: toque nela. A cada 5 sementes, uma planta grátis, sem custo nem recarga.", "Переможене сміття іноді губить насінинку - натисни її. Кожні 5 насінин - безкоштовна рослинка без ціни й відновлення."],
	"addon_seeds_help": ["Nasiona liczą się podwójnie przez 2 fale", "Seeds count double for 2 waves", "Las semillas valen doble 2 oleadas", "Les graines comptent double pendant 2 vagues", "Samen zählen 2 Wellen lang doppelt", "Sementes valem dobrado por 2 ondas", "Насіння рахується подвійно 2 хвилі"],
	"addon_transplant": ["Przesadzanie roślin", "Replanting", "Trasplante", "Repiquage", "Umpflanzen", "Transplante", "Пересаджування"],
	"addon_transplant_desc": ["Raz na 10 s możesz przesadzić roślinkę na sąsiednie wolne pole: tapnij ją, a potem nowe pole. Śmieci są za to szybsze.", "Once every 10 s you can move a plant to a free neighbouring spot: tap it, then the new spot. But the trash is faster.", "Cada 10 s puedes mover una planta a una casilla vecina libre: tócala y luego la nueva casilla. Pero la basura es más rápida.", "Toutes les 10 s, tu peux déplacer une plante sur une case voisine libre : touche-la, puis la nouvelle case. Mais les déchets sont plus rapides.", "Alle 10 s kannst du eine Pflanze auf ein freies Nachbarfeld setzen: tippe sie an, dann das neue Feld. Dafür ist der Müll schneller.", "A cada 10 s você pode mover uma planta para um lugar vizinho livre: toque nela e depois no novo lugar. Mas o lixo é mais rápido.", "Раз на 10 с можна пересадити рослинку на сусіднє вільне поле: натисни її, потім нове поле. Зате сміття швидше."],
	"addon_transplant_help": ["Przesadzanie co 5 s", "Replant every 5 s", "Trasplantar cada 5 s", "Repiquer toutes les 5 s", "Alle 5 s umpflanzen", "Transplantar a cada 5 s", "Пересаджувати кожні 5 с"],
	"addon_animals": ["Uwolnij zwierzątka", "Free the Animals", "Libera a los Animales", "Libère les Animaux", "Befreie die Tiere", "Liberte os Animais", "Звільни звірят"],
	"addon_animals_desc": ["Na planszy stoją klatki ze zwierzątkami. Zestrzel klatkę, a zwierzątko pomoże: jeż blokuje, ptaszek przynosi krople, żabka zjada śmiecia, motyl przyspiesza odnawianie.", "Cages with animals stand on the board. Shoot a cage open and the animal helps: the hedgehog blocks, the bird brings drops, the frog eats a trash monster, the butterfly speeds up recharging.", "Hay jaulas con animales en el tablero. Rompe una jaula y el animal ayuda: el erizo bloquea, el pájaro trae gotas, la rana se come una basura y la mariposa acelera la recarga.", "Des cages avec des animaux sont sur le plateau. Ouvre une cage et l'animal t'aide : le hérisson bloque, l'oiseau apporte des gouttes, la grenouille mange un déchet, le papillon accélère la recharge.", "Auf dem Feld stehen Käfige mit Tieren. Schieß einen Käfig auf und das Tier hilft: der Igel blockiert, der Vogel bringt Tropfen, der Frosch frisst Müll, der Schmetterling beschleunigt das Nachwachsen.", "Há gaiolas com animais no tabuleiro. Abra uma gaiola e o animal ajuda: o ouriço bloqueia, o passarinho traz gotas, o sapo come um lixo e a borboleta acelera a recarga.", "На полі клітки зі звірятами. Збий клітку, і звірятко допоможе: їжак блокує, пташка приносить краплі, жабка з'їдає сміття, метелик пришвидшує відновлення."],
	"addon_animals_help": ["Klatki mają połowę życia", "Cages have half health", "Las jaulas tienen la mitad de vida", "Les cages ont moitié moins de vie", "Käfige haben halbes Leben", "Gaiolas com metade da vida", "Клітки мають половину життя"],
	"addon_invisible": ["Niewidzialne śmieci", "Invisible Trash", "Basura Invisible", "Déchets Invisibles", "Unsichtbarer Müll", "Lixo Invisível", "Невидиме сміття"],
	"addon_invisible_desc": ["Część śmieci jest prawie niewidoczna. Zobaczysz je, gdy podejdą do roślin albo gdy coś je trafi.", "Some trash is almost invisible. You'll see it when it gets close to your plants or when something hits it.", "Parte de la basura es casi invisible. La verás cuando se acerque a tus plantas o cuando algo la golpee.", "Certains déchets sont presque invisibles. Tu les verras quand ils approchent de tes plantes ou quand quelque chose les touche.", "Ein Teil des Mülls ist fast unsichtbar. Du siehst ihn, wenn er nah an deine Pflanzen kommt oder getroffen wird.", "Parte do lixo é quase invisível. Você o verá quando chegar perto das plantas ou quando algo o acertar.", "Частина сміття майже невидима. Побачиш його, коли воно підійде до рослинок або коли щось у нього влучить."],
	"addon_invisible_help": ["Świetlik pokazuje wrogów w jednym rzędzie", "A firefly reveals enemies in one row", "Una luciérnaga muestra los enemigos de una fila", "Une luciole révèle les ennemis d'une rangée", "Ein Glühwürmchen zeigt die Gegner einer Reihe", "Um vaga-lume revela inimigos de uma fileira", "Світлячок показує ворогів в одному ряду"],
	"addon_giant": ["Olbrzymia roślinka", "Giant Plant", "Planta Gigante", "Plante Géante", "Riesenpflanze", "Planta Gigante", "Велетенська рослинка"],
	"addon_giant_desc": ["Na początku wybierz roślinkę, która stanie się olbrzymem: zajmie 2x2 pola, ma 4 razy więcej życia i działa mocniej. Śmieci też są silniejsze.", "At the start pick a plant to become a giant: it takes 2x2 spots, has 4 times the health and works harder. The trash is stronger too.", "Al empezar elige una planta que será gigante: ocupa 2x2 casillas, tiene 4 veces más vida y es más fuerte. La basura también es más fuerte.", "Au début, choisis une plante qui deviendra géante : elle prend 2x2 cases, a 4 fois plus de vie et agit plus fort. Les déchets aussi sont plus forts.", "Wähle zu Beginn eine Pflanze, die zum Riesen wird: 2x2 Felder, vierfaches Leben, stärkere Wirkung. Auch der Müll ist stärker.", "No início escolha uma planta para virar gigante: ocupa 2x2 lugares, tem 4 vezes mais vida e é mais forte. O lixo também fica mais forte.", "На початку обери рослинку-велетня: займе 2x2 поля, має в 4 рази більше життя й діє сильніше. Сміття теж сильніше."],
	"addon_giant_help": ["Olbrzym zaczyna z nawozem", "The giant starts fertilized", "El gigante empieza con abono", "Le géant commence avec de l'engrais", "Der Riese startet gedüngt", "O gigante começa adubado", "Велетень починає з добривом"],
	"addon_quiz": ["Quiz ekologiczny", "Eco Quiz", "Cuestionario Ecológico", "Quiz Écolo", "Öko-Quiz", "Quiz Ecológico", "Екологічна вікторина"],
	"addon_quiz_desc": ["Codziennie 5 pytań: do którego pojemnika wyrzucić dany śmieć? Za dobre odpowiedzi dostajesz roślimonety, a za komplet - sadzonkę.", "5 questions every day: which bin does this trash go in? Correct answers give plant coins, and all 5 give a sapling.", "5 preguntas al día: ¿en qué contenedor va esta basura? Las respuestas correctas dan plantamonedas, y las 5, un brote.", "5 questions par jour : dans quelle poubelle va ce déchet ? Les bonnes réponses donnent des pièces-plantes, et les 5 une pousse.", "Jeden Tag 5 Fragen: In welche Tonne gehört dieser Müll? Richtige Antworten bringen Pflanzenmünzen, alle 5 einen Setzling.", "5 perguntas por dia: em qual lixeira vai este lixo? Respostas certas dão moedas-planta, e as 5 dão uma muda.", "Щодня 5 питань: у який контейнер викинути це сміття? За правильні відповіді - рослимонети, за всі 5 - саджанець."],
	"addon_sort_game": ["Sortownia", "Sorting Line", "Planta de Separación", "Centre de Tri", "Sortierband", "Esteira de Separação", "Сортувальня"],
	"addon_sort_game_desc": ["Śmieci jadą taśmą - przeciągaj każdy do właściwego pojemnika. Taśma przyspiesza, a 3 pomyłki kończą zmianę. Za wynik dostajesz sadzonki.", "Trash rides on a belt - drag each piece to the right bin. The belt speeds up and 3 mistakes end your shift. Your score earns saplings.", "La basura va por una cinta: arrastra cada una a su contenedor. La cinta acelera y 3 errores terminan el turno. Tu puntuación da brotes.", "Les déchets défilent sur un tapis : glisse chacun dans la bonne poubelle. Le tapis accélère et 3 erreurs finissent le service. Ton score donne des pousses.", "Müll fährt auf einem Band - zieh jedes Teil in die richtige Tonne. Das Band wird schneller, 3 Fehler beenden die Schicht. Dein Ergebnis bringt Setzlinge.", "O lixo passa numa esteira: arraste cada um para a lixeira certa. A esteira acelera e 3 erros encerram o turno. Sua pontuação dá mudas.", "Сміття їде стрічкою - перетягуй кожне в правильний контейнер. Стрічка пришвидшується, 3 помилки завершують зміну. За результат - саджанці."],
	"addon_sorting": ["Sortowanie śmieci", "Trash Sorting", "Separar la Basura", "Tri des Déchets", "Mülltrennung", "Separação do Lixo", "Сортування сміття"],
	"addon_sorting_desc": ["Śmieci mają kolory pojemników: żółty (plastik i metal), niebieski (papier) i czarny (zmieszane). Roślinka zadaje podwójne obrażenia śmieciom w swoim kolorze, a słabsze pozostałym.", "Trash has bin colours: yellow (plastic and metal), blue (paper) and black (mixed). A plant does double damage to trash of its own colour and less to the rest.", "La basura tiene colores de contenedor: amarillo (plástico y metal), azul (papel) y negro (mixto). Una planta hace el doble de daño a la basura de su color y menos al resto.", "Les déchets ont des couleurs de poubelle : jaune (plastique et métal), bleu (papier) et noir (tout-venant). Une plante fait double dégât à sa couleur et moins aux autres.", "Müll hat Tonnenfarben: gelb (Plastik und Metall), blau (Papier) und schwarz (Restmüll). Eine Pflanze macht doppelten Schaden an Müll ihrer Farbe und weniger am Rest.", "O lixo tem cores de lixeira: amarelo (plástico e metal), azul (papel) e preto (comum). Uma planta causa o dobro de dano ao lixo da sua cor e menos ao resto.", "Сміття має кольори контейнерів: жовтий (пластик і метал), синій (папір) і чорний (змішане). Рослинка завдає подвійної шкоди сміттю свого кольору й меншої - іншому."],
	"am_umbrella": ["Parasol", "Umbrella", "Paraguas", "Parapluie", "Schirm", "Guarda-chuva", "Парасоля"],
	"am_belt_stop": ["Stop taśm", "Stop belts", "Parar cintas", "Stop tapis", "Bänder stopp", "Parar esteiras", "Стоп стрічок"],
	"am_rod_place": ["Tapnij pole, na którym stanie piorunochron.", "Tap the spot for the lightning rod.", "Toca la casilla del pararrayos.", "Touche la case du paratonnerre.", "Tippe auf das Feld für den Blitzableiter.", "Toque o lugar do para-raios.", "Натисни поле для громовідводу."],
	"am_bridge_place": ["Tapnij pole na rzece, żeby postawić kładkę.", "Tap a river spot to build a bridge.", "Toca una casilla del río para poner un puente.", "Touche une case de la rivière pour poser une passerelle.", "Tippe auf ein Flussfeld, um einen Steg zu bauen.", "Toque um lugar do rio para fazer uma ponte.", "Натисни поле на річці, щоб поставити кладку."],
	"am_bridge_free": ["Kładka (darmowe: %d)", "Bridge (free: %d)", "Puente (gratis: %d)", "Passerelle (gratuites : %d)", "Steg (gratis: %d)", "Ponte (grátis: %d)", "Кладка (безкоштовні: %d)"],
	"am_bridge_cost": ["Kładka (%d kropli)", "Bridge (%d drops)", "Puente (%d gotas)", "Passerelle (%d gouttes)", "Steg (%d Tropfen)", "Ponte (%d gotas)", "Кладка (%d крапель)"],
	"am_bridge_only_river": ["Kładkę stawia się tylko na rzece.", "Bridges only go on the river.", "Los puentes solo van en el río.", "Les passerelles se posent seulement sur la rivière.", "Stege gibt es nur auf dem Fluss.", "Pontes só vão no rio.", "Кладку ставлять лише на річці."],
	"am_bridge_exists": ["Tu już jest kładka.", "There is already a bridge here.", "Aquí ya hay un puente.", "Il y a déjà une passerelle ici.", "Hier ist schon ein Steg.", "Já há uma ponte aqui.", "Тут уже є кладка."],
	"am_river_no_plant": ["Na rzece sadzisz tylko na kładce.", "On the river you can only plant on a bridge.", "En el río solo se planta en un puente.", "Sur la rivière, on plante seulement sur une passerelle.", "Auf dem Fluss pflanzt du nur auf einem Steg.", "No rio só se planta em uma ponte.", "На річці садять лише на кладці."],
	"am_firefly_place": ["Tapnij rząd, który ma oświetlić świetlik.", "Tap the row the firefly should light up.", "Toca la fila que iluminará la luciérnaga.", "Touche la rangée que la luciole doit éclairer.", "Tippe auf die Reihe für das Glühwürmchen.", "Toque a fileira que o vaga-lume vai iluminar.", "Натисни ряд, який освітить світлячок."],
	"am_transplant_hint": ["Tapnij posadzoną roślinkę, a potem sąsiednie wolne pole, żeby ją przesadzić.", "Tap a planted plant, then a free neighbouring spot to move it.", "Toca una planta y luego una casilla vecina libre para moverla.", "Touche une plante, puis une case voisine libre pour la déplacer.", "Tippe eine Pflanze an, dann ein freies Nachbarfeld, um sie umzusetzen.", "Toque uma planta e depois um lugar vizinho livre para movê-la.", "Натисни посаджену рослинку, потім сусіднє вільне поле, щоб її пересадити."],
	"am_belt_stopped": ["Taśmy stoją", "Belts stopped", "Cintas paradas", "Tapis arrêtés", "Bänder stehen", "Esteiras paradas", "Стрічки стоять"],
	"am_belt_in": ["Taśmy ruszą za %d s", "Belts move in %d s", "Las cintas se mueven en %d s", "Les tapis bougent dans %d s", "Bänder fahren in %d s", "Esteiras andam em %d s", "Стрічки рушать за %d с"],
	"am_tree_hp": ["Drzewko: %d%%", "Tree: %d%%", "Árbol: %d%%", "Arbre : %d%%", "Baum: %d%%", "Árvore: %d%%", "Деревце: %d%%"],
	"am_seeds": ["Nasiona: %d / %d", "Seeds: %d / %d", "Semillas: %d / %d", "Graines : %d / %d", "Samen: %d / %d", "Sementes: %d / %d", "Насіння: %d / %d"],
	"am_move_ready": ["Przesadzanie: gotowe", "Replanting: ready", "Trasplante: listo", "Repiquage : prêt", "Umpflanzen: bereit", "Transplante: pronto", "Пересаджування: готово"],
	"am_move_in": ["Przesadzanie za %d s", "Replant in %d s", "Trasplante en %d s", "Repiquage dans %d s", "Umpflanzen in %d s", "Transplante em %d s", "Пересаджування за %d с"],
	"am_bonus_left": ["%s: %d s", "%s: %d s", "%s: %d s", "%s : %d s", "%s: %d s", "%s: %d s", "%s: %d с"],
	"am_bonus_recharge": ["Szybsze odnawianie", "Faster recharge", "Recarga rápida", "Recharge rapide", "Schneller nachwachsen", "Recarga rápida", "Швидше відновлення"],
	"am_bonus_slow": ["Wolniejsze śmieci", "Slower trash", "Basura lenta", "Déchets lents", "Langsamerer Müll", "Lixo lento", "Повільніше сміття"],
	"am_bonus_water": ["Więcej kropel", "More drops", "Más gotas", "Plus de gouttes", "Mehr Tropfen", "Mais gotas", "Більше крапель"],
	"am_bonus_choose": ["Pszczółka złapana! Wybierz premię na 15 s.", "Bee caught! Pick a 15 s bonus.", "¡Abejita atrapada! Elige un premio de 15 s.", "Abeille attrapée ! Choisis un bonus de 15 s.", "Bienchen gefangen! Wähle einen 15-s-Bonus.", "Abelhinha pega! Escolha um bônus de 15 s.", "Бджілку спіймано! Обери бонус на 15 с."],
	"am_season_spring": ["Wiosna", "Spring", "Primavera", "Printemps", "Frühling", "Primavera", "Весна"],
	"am_season_summer": ["Lato", "Summer", "Verano", "Été", "Sommer", "Verão", "Літо"],
	"am_season_autumn": ["Jesień", "Autumn", "Otoño", "Automne", "Herbst", "Outono", "Осінь"],
	"am_season_winter": ["Zima", "Winter", "Invierno", "Hiver", "Winter", "Inverno", "Зима"],
	"am_season_start_spring": ["Wiosna: Kaktusy dają krople szybciej!", "Spring: Cacti give drops faster!", "Primavera: ¡los Cactus dan gotas más rápido!", "Printemps : les Cactus donnent des gouttes plus vite !", "Frühling: Kakteen geben schneller Tropfen!", "Primavera: os Cactos dão gotas mais rápido!", "Весна: Кактуси дають краплі швидше!"],
	"am_season_start_summer": ["Lato: upał! Sadź Liście Bananowca obok roślin.", "Summer: heat! Plant Banana Leaves next to your plants.", "Verano: ¡calor! Planta Hojas de Plátano junto a tus plantas.", "Été : canicule ! Plante des Feuilles de Bananier à côté.", "Sommer: Hitze! Pflanze Bananenblätter neben deine Pflanzen.", "Verão: calor! Plante Folhas de Bananeira ao lado.", "Літо: спека! Сади Бананові Листи поруч із рослинками."],
	"am_season_start_autumn": ["Jesień: wiatr co chwilę odpycha śmieci!", "Autumn: the wind keeps pushing the trash back!", "Otoño: ¡el viento empuja la basura!", "Automne : le vent repousse les déchets !", "Herbst: Der Wind schiebt den Müll immer wieder zurück!", "Outono: o vento empurra o lixo!", "Осінь: вітер раз у раз відкидає сміття!"],
	"am_season_start_winter": ["Zima: wszystko zwalnia - śmieci i pociski.", "Winter: everything slows down - trash and shots.", "Invierno: todo va más lento, basura y disparos.", "Hiver : tout ralentit, déchets et tirs.", "Winter: Alles wird langsamer - Müll und Schüsse.", "Inverno: tudo fica lento, lixo e tiros.", "Зима: усе сповільнюється - сміття й снаряди."],
	"am_wind": ["Jesienny wiatr odpycha śmieci!", "The autumn wind pushes the trash back!", "¡El viento de otoño empuja la basura!", "Le vent d'automne repousse les déchets !", "Der Herbstwind schiebt den Müll zurück!", "O vento de outono empurra o lixo!", "Осінній вітер відкидає сміття!"],
	"am_storm_warning": ["Nadciąga burza! Uważaj na zaciemnione rzędy.", "A storm is coming! Watch the dark rows.", "¡Llega una tormenta! Cuidado con las filas oscuras.", "Un orage arrive ! Attention aux rangées sombres.", "Ein Gewitter kommt! Achte auf die dunklen Reihen.", "Vem tempestade! Cuidado com as fileiras escuras.", "Наближається гроза! Стеж за темними рядами."],
